<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.HomeFragment">

    <!-- Header Background -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#610E0E"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:subtitleTextColor="@android:color/white"
        app:titleTextColor="@android:color/white" />
    T
    <!-- GridLayout for Buttons -->
    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:columnCount="2"
        app:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_bias="0.4">

        <Button
            android:id="@+id/btnToFourth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#610E0E"
            android:text="Ke 4"
            android:textColor="#C1B9B9"
            app:layout_gravity="fill_horizontal" />

        <Button
            android:id="@+id/btnToFifth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#610E0E"
            android:text="Pertemuan 5"
            android:textColor="#C1B9B9"
            app:layout_gravity="fill_horizontal" />

        <Button
            android:id="@+id/btnToSeventh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#610E0E"
            android:text="Pertemuan 7"
            android:textColor="#C1B9B9"
            app:layout_gravity="fill_horizontal" />

        <Button
            android:id="@+id/btnToTenth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#610E0E"
            android:text="Pertemuan 10"
            android:textColor="#C1B9B9"
            app:layout_gravity="fill_horizontal" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="#212121"
            android:text="Logout"
            app:layout_columnSpan="2"
            app:layout_gravity="center_horizontal" />

    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>